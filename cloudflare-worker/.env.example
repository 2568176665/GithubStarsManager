# GitHub access token used by the Worker GitHub proxy.
# Production: configure as a Cloudflare Worker Secret named GITHUB_TOKEN.
GITHUB_TOKEN=your_github_token_here

# AI provider configuration.
# Production: configure AI_API_KEY as a Cloudflare Worker Secret.
AI_API_KEY=your_ai_api_key_here
AI_API_TYPE=openai-compatible
AI_BASE_URL=https://example.com/v1
AI_MODEL=your-model
